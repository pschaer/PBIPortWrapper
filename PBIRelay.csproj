<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RollForward>LatestMajor</RollForward>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- UseWPF only for UIAutomationClient (UiaDirtyStateProbe, #59); no WPF UI exists -->
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Version Information -->
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>

		<!-- Product Information -->
		<Product>PBIRelay</Product>
		<Description>A stable XMLA endpoint for your local Power BI Desktop semantic models, so Excel and other tools connect by name and keep working across Desktop restarts</Description>
		<Authors>Pascal Schär</Authors>
		<Copyright>Copyright © 2025 Pascal Schär. Licensed under MIT License.</Copyright>
		<ApplicationIcon>app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Core owns all non-UI logic and its package dependencies (transitive) -->
		<ProjectReference Include="Core\PBIRelay.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core and Tests are separate projects; keep them out of this project's compile glob -->
		<Compile Remove="Core\**;Tests\**" />
		<None Remove="Core\**;Tests\**" />
		<EmbeddedResource Remove="Core\**;Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\app_icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="EnforceCodeSizeLimits" AfterTargets="Build">
		<Exec Command="powershell -Command &quot;$failed = $false; if (Test-Path 'MainForm.cs') { $c = (Get-Content 'MainForm.cs').Count; if ($c -gt 500) { Write-Host 'EXEC : error : MainForm.cs is too large (' $c ' lines). Limit is 500.'; $failed = $true } elseif ($c -gt 400) { Write-Host 'EXEC : warning : MainForm.cs is getting large (' $c ' lines). Consider refactoring (Limit 400).' } }; if (Test-Path 'Presenters') { Get-ChildItem 'Presenters\*.cs' | ForEach-Object { $c = (Get-Content $_.FullName).Count; if ($c -gt 250) { Write-Host 'EXEC : error : ' $_.Name ' is too large (' $c ' lines). Limit is 250.'; $failed = $true } } }; if ($failed) { exit 1 }&quot;" />
	</Target>
</Project>